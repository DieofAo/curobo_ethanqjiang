  <!-- TCP: 工具中心点(Tool Center Point)。
       沿 LINK_6 局部 +Z 平移 0.19m, 无任何旋转 -> TCP 的姿态与 LINK_6 完全一致。
       xtrainer_plan 的规划以此为 ee_link, 因此 yaml 里给的 position/rpy_deg
       直接就是 TCP 的目标位姿, 姿态搜索的右乘也是绕 TCP 自身轴(= LINK_6 轴)。
       本 link 无碰撞几何, 碰撞检测仍由 LINK_6 的 9 个碰撞球承担。 -->
  <link name="TCP_LINK"/>
  <joint name="TCP_joint" type="fixed">
    <origin xyz="0 0 0.19" rpy="0 0 0" />
    <parent link="LINK_6" />
    <child link="TCP_LINK" />
  </joint>

